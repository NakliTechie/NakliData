# Source: https://www.w3.org/TR/skos-reference/#L280
# W3C SKOS Reference example, made absolute and given explicit prefixes.
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://example.test/skos/A> a skos:Concept ;
  skos:prefLabel "love"@en ;
  skos:altLabel "adoration"@en ;
  skos:broader <https://example.test/skos/B> ;
  skos:inScheme <https://example.test/skos/S> .

<https://example.test/skos/B> a skos:Concept ;
  skos:prefLabel "emotion"@en ;
  skos:altLabel "feeling"@en ;
  skos:topConceptOf <https://example.test/skos/S> .

<https://example.test/skos/S> a skos:ConceptScheme ;
  dct:title "My First Thesaurus" ;
  skos:hasTopConcept <https://example.test/skos/B> .
