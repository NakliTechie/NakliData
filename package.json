{
  "name": "naklidata",
  "version": "0.1.0",
  "description": "Browser-native semantic data workbench.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/generate-product-truth.mjs --check && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --dev",
    "check": "tsc --noEmit && biome check src tests eval && node scripts/check-color-tokens.mjs && node scripts/check-engine-boundary.mjs && node scripts/generate-product-truth.mjs --check && node scripts/check-bundle-size.mjs",
    "fmt": "biome format --write src tests eval",
    "lint": "biome lint src tests eval",
    "test": "vitest run",
    "warehouse:conformance": "vitest run tests/warehouse-conformance.test.ts tests/warehouse-bridge-conformance.test.ts tests/databricks-statement-adapter.test.ts tests/snowflake-sql-adapter.test.ts --reporter=verbose",
    "warehouse:adapter-conformance": "vitest run tests/databricks-statement-adapter.test.ts tests/snowflake-sql-adapter.test.ts --reporter=verbose",
    "warehouse:iceberg-candidate": "node scripts/probe-duckdb-iceberg-candidate.mjs",
    "warehouse:iceberg-runtime": "NAKLIDATA_CHECKED_IN_RUNTIME=1 node scripts/probe-duckdb-iceberg-candidate.mjs",
    "warehouse:iceberg-public": "node scripts/probe-public-iceberg-product.mjs",
    "bridge:check": "npm --prefix packages/compute-bridge run check",
    "bridge:test": "npm --prefix packages/compute-bridge test",
    "bridge:build": "npm --prefix packages/compute-bridge run build",
    "bridge:audit": "npm --prefix packages/compute-bridge run audit && npm --prefix packages/compute-bridge run sbom:check",
    "test:e2e": "npm run build && npx playwright test --config tests/e2e/playwright.config.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "eval": "node eval/run.mjs",
    "gen-examples": "node scripts/gen-examples.mjs",
    "test:watch": "vitest",
    "postinstall": "node scripts/fetch-duckdb-fallback.mjs && node scripts/fetch-duckdb-extensions.mjs && node scripts/vendor-sql-wasm.mjs && node scripts/fetch-pyodide.mjs && node scripts/fetch-webr.mjs",
    "predeploy": "node scripts/stage-guide.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@deck.gl/core": "^9.3.2",
    "@deck.gl/layers": "^9.3.2",
    "@deck.gl/mapbox": "^9.3.2",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@huggingface/transformers": "^4.2.0",
    "@observablehq/plot": "^0.6.17",
    "apache-arrow": "^17.0.0",
    "cytoscape": "^3.33.3",
    "fastest-levenshtein": "^1.0.16",
    "maplibre-gl": "^5.24.0",
    "n3": "2.1.1",
    "sql.js": "^1.12.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.60.0",
    "@types/cytoscape": "^3.21.9",
    "@types/n3": "1.26.0",
    "@types/node": "^22.5.0",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.1",
    "playwright": "^1.60.0",
    "rdf-validate-shacl": "0.6.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "webr": "0.6.0",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22"
  }
}
